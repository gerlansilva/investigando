{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Investigando",
  "version": "0.0.1",
  "identifier": "br.investigando.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run construir",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Investigando",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["investigando"],
        "name": "Projeto do Investigando",
        "description": "Projeto do Investigando",
        "role": "Editor",
        "mimeType": "application/json"
      }
    ]
  }
}
